# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# GOOGLE_SHEETS_SPREADSHEET_ID: The Google Spreadsheet ID or full published URL.
# You can leave this empty to use the built-in initial catalogue, or paste your Google Sheet ID:
# Example: 1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms
GOOGLE_SHEETS_SPREADSHEET_ID=""

# Optional API key if using Google Sheets v4 API instead of public CSV/TSV publishing
GOOGLE_SHEETS_API_KEY=""
